#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
#Fix error
apk add --no-cache miniupnpc
if [ -e /usr/lib/libminiupnpc.so.20 -a ! -e /usr/lib/libminiupnpc.so.19 ]; then
	apk add --no-cache --allow-untrusted /usr/local/etc/libminiupnpc-so19-fake-1.0-r0.apk
fi
PKG_LIB="su-exec transmission-daemon transmission-cli"
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting basic configurations"
mkdir -p /conf.d
mkdir -p /conf.d/transmission-daemon
touch /conf.d/transmission-daemon/settings.json
mkdir -p /data
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

